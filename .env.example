# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=agentic_memory_db

# OpenAI API Key for embeddings (text-embedding-3-small) and LLM (gpt-4o-mini)
# If left empty, the application will automatically fall back to an intelligent mock engine
# that generates 1536-dimensional deterministic vectors and smart context-aware responses!
OPENAI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
