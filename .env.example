# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/casememory?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/casememory?retryWrites=true&w=majority
MONGODB_DB_NAME=casememory

# JWT Secret for Session Authentication (generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# LLM API Key (e.g. Google Gemini API key or OpenAI API key)
LLM_API_KEY=replace_with_your_llm_api_key

# LLM Provider Configuration (defaults to gemini)
LLM_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-1.5-flash

